{
  "name": "@zigshape/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "zigshape": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun build --compile --outfile dist/zigshape ./src/main.ts",
