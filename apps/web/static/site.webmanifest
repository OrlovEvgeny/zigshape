{
  "name": "zigshape",
  "short_name": "zigshape",
  "description": "Generate Zig structs from JSON, YAML, TOML, XML, CSV, ZON and TOON.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#121211",
