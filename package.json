{
  "name": "zigshape",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run --filter '@zigshape/web' dev",
    "build:web": "bun run --filter '@zigshape/web' build",
    "cli": "bun run --filter '@zigshape/cli' start --"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.3"
  }
}
